#!/bin/bash

#
# Procesa las peticiones pendientes para cada una de las etiquetas.
#

# venv's python
#PYTHON="/home/vcarceler/sirin/venv/bin/python"
# Sirin's manage.py
#MANAGE="/home/vcarceler/sirin/sirin/manage.py"

secret=`cat /home/vcarceler/playbooks-elpuig/secrets/sirin-password`

# ARA
playbooks="/home/vcarceler/playbooks-elpuig"
export ANSIBLE_CALLBACK_PLUGINS="$(python3 -m ara.setup.callback_plugins)"

for x in ada-u2604.yml aif-u2604.yml ampa-u2204.yml asix1-u2404.yml aula305-u2604.yml biblioteca-u2604.yml carret10smx2c-u2604.yml carret10-smx2c-u2604.yml carret11-af1-u2604.yml carret12-ga1-u2604.yml carret13-smx2d-u2604.yml carret14-asix1-u2604.yml chomsky-u2604.yml consergeria-u2204.yml darwin-u2604.yml daw1-u2404.yml dpt-aif-u2404.yml dpt-cast-u2404.yml dpt-cat-u2404.yml dpt-ciencies-u2004.yml dpt-ciencies-lab-u2004.yml dpt-dibuix-u2404.yml dpt-edufis-u2204.yml dpt-erasmus-u2004.yml dpt-filosofia-u2004.yml dpt-fisicaiquimica-u2404.yml dpt-historia-u2004.yml dpt-inf-u2604.yml dpt-inf-u2204.yml dpt-ing-u2404.yml escher-u2604.yml lenovo-v510-u2004.yml dpt-mat-u2004.yml dpt-musica-u2004.yml dpt-psico-u2004.yml dpt-religio-u2204.yml dpt-tecno-u2004.yml esobatx-u2404.yml esobatx_dept-u2004.yml esobatx_wifi-u2404.yml matricula-u2004.yml portatils-alumnes-u2404.yml portatils-alumnes-u2604.yml portatils-ad1-u2604.yml portatils-af2-u2604.yml portatils-dev-u2604.yml portatils-docents-u2404.yml portatils-docents-u2604.yml portatils-prestec-u2604.yml portatils-tecno-u2204.yml saladeguardies-u2604.yml saladeprofessors-u2604.yml secretaria-u2004.yml snowden-u2604.yml stallman-u2604.yml tesla-u2604.yml torvalds-u2604.yml turing-u2604.yml
do
	# Comprobamos si hay peticiones pendientes
	n=`wget http://127.0.0.1:8080/getnumberofrequests/$x -O -`
	echo "Para la etiqueta $x hay $n peticiones pendientes."
	if [ $n -gt 0 ]
	then
		hosts=`wget http://127.0.0.1:8080/gethosts/$secret/$x -O -`
		echo "Lanzo ansible-playbook -i $playbooks/hosts $playbooks/$x --limit=$hosts"
		nice ansible-playbook -i $playbooks/hosts $playbooks/$x --limit=$hosts &
	else
		echo No hay nada que hacer
	fi
done

echo "Esperando que acaben las tareas ansible-playbook..."
wait
echo "Todos los playbooks de ansible se han completado."
